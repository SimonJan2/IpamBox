{"nodes": [{"id": "docker_compose_db_service", "label": "db service (postgres:16-alpine)", "file_type": "code", "source_file": "docker-compose.yml", "source_location": "docker-compose.yml:2-20", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docker_compose_redis_service", "label": "redis service (redis:7-alpine)", "file_type": "code", "source_file": "docker-compose.yml", "source_location": "docker-compose.yml:22-36", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docker_compose_api_service", "label": "api service", "file_type": "code", "source_file": "docker-compose.yml", "source_location": "docker-compose.yml:38-89", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docker_compose_scanner_service", "label": "scanner service", "file_type": "code", "source_file": "docker-compose.yml", "source_location": "docker-compose.yml:91-123", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docker_compose_web_service", "label": "web service (pinned 192.0.2.10)", "file_type": "code", "source_file": "docker-compose.yml", "source_location": "docker-compose.yml:125-143", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pinned at ipv4_address 192.0.2.10 so IPAMBOX_TRUSTED_PROXIES on the api can trust exactly this peer for X-Forwarded-For \u2014 nothing else on the bridge can spoof it."}, {"id": "docker_compose_ipam_network", "label": "ipam bridge network 192.0.2.0/24", "file_type": "code", "source_file": "docker-compose.yml", "source_location": "docker-compose.yml:150-160", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "192.0.2.0/24 is RFC 5737 TEST-NET-1 \u2014 reserved for documentation, so it can never collide with a real LAN/WAN client; changing it requires updating IPAMBOX_TRUSTED_PROXIES and web's ipv4_address together."}, {"id": "docker_compose_api_bind", "label": "API_BIND publish binding", "file_type": "code", "source_file": "docker-compose.yml", "source_location": "docker-compose.yml:73-77", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The API is published on ALL interfaces by default (deliberate LAN access to /docs, /metrics and scripts); API_BIND=127.0.0.1 restricts it to loopback (web UI only)."}, {"id": "docker_compose_trusted_proxies", "label": "IPAMBOX_TRUSTED_PROXIES env", "file_type": "code", "source_file": "docker-compose.yml", "source_location": "docker-compose.yml:52-56", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "X-Forwarded-For is honored only from these peers \u2014 192.0.2.10 is web's pinned address on the ipam bridge; keep in sync with services.web.networks; uvicorn gets the same list via --forwarded-allow-ips."}, {"id": "docker_compose_uvicorn_proxy_flags", "label": "uvicorn --proxy-headers --forwarded-allow-ips", "file_type": "code", "source_file": "docker-compose.yml", "source_location": "docker-compose.yml:83", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uvicorn is launched with --proxy-headers and --forwarded-allow-ips $IPAMBOX_TRUSTED_PROXIES so the app sees the forwarded client IP only from trusted peers."}, {"id": "docker_compose_scan_max_hosts", "label": "SCAN_MAX_HOSTS env", "file_type": "code", "source_file": "docker-compose.yml", "source_location": "docker-compose.yml:63,109", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Scan guards live in the API (validation/rate-limit); the worker reads them too \u2014 set on both api and scanner with default 4096."}, {"id": "docker_compose_loopback_binding", "label": "DB/Redis loopback-only port publishing", "file_type": "code", "source_file": "docker-compose.yml", "source_location": "docker-compose.yml:13-15,30-31", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Postgres (127.0.0.1:5432) and Redis (127.0.0.1:${REDIS_PORT:-6378}) publish on loopback only \u2014 bound to loopback while still reachable from the host-networked scanner container."}, {"id": "docker_compose_scanner_host_mode", "label": "scanner network_mode: host + NET_ADMIN/NET_RAW", "file_type": "code", "source_file": "docker-compose.yml", "source_location": "docker-compose.yml:94-99", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Host networking gives the worker real L2 access for ARP scanning; it reaches Postgres/Redis via the loopback-published ports."}, {"id": "docker_compose_cookie_secure_env", "label": "IPAMBOX_COOKIE_SECURE env", "file_type": "code", "source_file": "docker-compose.yml", "source_location": "docker-compose.yml:49-51", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "false so logins work over plain HTTP on a LAN (browsers reject Secure cookies on non-localhost http origins); set true when serving HTTPS."}, {"id": "docker_compose_alembic_automigrate", "label": "alembic upgrade head on api start", "file_type": "code", "source_file": "docker-compose.yml", "source_location": "docker-compose.yml:83", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docker_compose_backup_volume", "label": "backupdata volume", "file_type": "code", "source_file": "docker-compose.yml", "source_location": "docker-compose.yml:69-70,114-115,145-148", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docker_compose_api_service", "target": "docker_compose_db_service", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docker-compose.yml", "source_location": "docker-compose.yml:42", "weight": 1.0}, {"source": "docker_compose_api_service", "target": "docker_compose_redis_service", "rel