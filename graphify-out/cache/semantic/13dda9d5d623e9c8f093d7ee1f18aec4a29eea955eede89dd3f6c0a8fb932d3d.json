{"nodes": [{"id": "snmp_snmp_enrichment", "label": "SNMP enrichment", "file_type": "document", "source_file": "frontend/src/content/docs/snmp.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "snmp_credential", "label": "SNMP device credential", "file_type": "document", "source_file": "frontend/src/content/docs/snmp.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Credentials are AES-256-GCM encrypted under the server master key and write-only \u2014 enabling SNMP without a stored credential is rejected because a poll that can't authenticate just burns timeouts."}, {"id": "snmp_poll", "label": "SNMP poll pipeline (sysName \u2192 IF-MIB \u2192 bridge-MAC \u2192 LLDP)", "file_type": "document", "source_file": "frontend/src/content/docs/snmp.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "snmp_cable_validation", "label": "Cable validation (documented vs observed)", "file_type": "document", "source_file": "frontend/src/content/docs/snmp.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Flags, never fixes: a mismatch never deletes or rewrites the cable \u2014 the human confirms what is true. Absent evidence is not a violation, so a failed bridge/LLDP walk can neither raise nor clear a flag; flags self-heal on the next contradictory-free poll."}, {"id": "snmp_inventory_sync", "label": "Inventory sync (Pull inventory)", "file_type": "document", "source_file": "frontend/src/content/docs/snmp.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The switch hands over its VLAN database, SVI/L3 subnets and ARP neighbors \u2014 subnets and neighbors the scanner can't see because they live on VLANs with no routable SVI. Everything runs preview \u2192 apply: nothing writes until a plan is approved, and apply is one transaction."}, {"id": "snmp_source_rank", "label": "SOURCE_RANK precedence (scan < snmp < integration < import < manual)", "file_type": "document", "source_file": "frontend/src/content/docs/snmp.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rows owned by a higher-authority source are reported as conflicts and never overwritten \u2014 an imported or hand-typed address keeps its MAC while a scan-discovered one can be enriched."}, {"id": "snmp_import_batch", "label": "import_batches kind='snmp' provenance", "file_type": "document", "source_file": "frontend/src/content/docs/snmp.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "snmp_trap_receiver", "label": "SNMP trap receiver", "file_type": "document", "source_file": "frontend/src/content/docs/snmp.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "requirements_cryptography", "target": "snmp_credential", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "frontend/src/content/docs/snmp.md", "source_location": null, "weight": 1.0}, {"source": "snmp_snmp_enrichment", "target": "snmp_poll", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "frontend/src/content/docs/snmp.md", "source_location": null, "weight": 1.0}, {"source": "snmp_inventory_sync", "target": "snmp_snmp_enrichment", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "frontend/src/content/docs/snmp.md", "source_location": null, "weight": 1.0}, {"source": "snmp_poll", "target": "snmp_cable_validation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "frontend/src/c