{"nodes": [{"id": "frontend_src_content_docs_lists_custom_lists", "label": "Custom Lists (user-defined tables)", "file_type": "document", "source_file": "frontend/src/content/docs/lists.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Exist for sheet-shaped data that does not fit a fixed entity (server rosters, contact lists, environment matrices) \u2014 anything that used to live in a workbook sheet and lose its shape on import."}, {"id": "frontend_src_content_docs_lists_ip_addresses", "label": "ip_addresses table (IPAM data store)", "file_type": "concept", "source_file": "frontend/src/content/docs/lists.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "frontend_src_content_docs_lists_ip_column_type", "label": "ip column type (live IPAM resolution)", "file_type": "concept", "source_file": "frontend/src/content/docs/lists.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Resolves cells live against ip_addresses (status dot, last-seen, click opens the address drawer); unresolved IPs render muted/dashed specifically to surface drift between the list and the IPAM."}, {"id": "frontend_src_content_docs_lists_key_column_merge", "label": "Key-column merge identity on re-import", "file_type": "rationale", "source_file": "frontend/src/content/docs/lists.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The key column is the merge identity when the same sheet is re-imported: changed cells update in place, rows absent from the source are kept and reported as 'missing from source' (never silently deleted), and manually edited cells win conflicts \u2014 pins, colors, ordering and manual rows always survive."}, {"id": "frontend_src_content_docs_lists_positional_column_keys", "label": "Positional column keys (c0, c1, \u2026)", "file_type": "rationale", "source_file": "frontend/src/content/docs/lists.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Columns are keyed positionally so renaming or relabeling a column never touches the stored JSON row data; removing a column only hides it \u2014 the cell values are kept."}, {"id": "frontend_src_content_docs_lists_hebrew_support", "label": "Hebrew-aware text handling", "file_type": "concept", "source_file": "frontend/src/content/docs/lists.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "frontend_src_content_docs_lists_ip_column_type", "target": "frontend_src_content_docs_lists_ip_addresses", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "frontend/src/content/docs/lists.md", "source_location": null, "weight": 1.0}, {"source": "frontend_src_content_docs_lists_custom_lists", "target": "frontend_src_content_docs_lists_ip_column_type", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "frontend/src/content/docs/lists.md", "source_location": null, "weight": 1.0}, {"source": "frontend_src_content_docs_lists_custom_lists", "target": "frontend_src_content_docs_lists_key_column_merge", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "frontend/src/content/docs/lists.md", "source_location": null, "weight": 1.0}, {"source": "frontend_src_content_docs_lists_custom_lists", "target": "frontend_src_content_docs_lists_positional_column_keys", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "frontend/src/content/docs/lists.md", "source_location": null, "weight": 1.0}, {"source": "frontend_src_content_docs_lists_custom_lists", "target": "frontend_src_content_docs_lists_hebrew_support", "relation": "refe