POSTGRES_USER=ipam
POSTGRES_PASSWORD=ipam
POSTGRES_DB=ipam
# Host-published ports (container ports stay 8000/3000). Defaults avoid clashes
# with common homelab services already using 8000/3000.
API_PORT=8001
# Interface the published API port binds to. 0.0.0.0 (default) exposes the API
# on the LAN — required for direct /docs, /metrics and script access from
# other machines. Set 127.0.0.1 to restrict it to loopback (web UI only).
API_BIND=0.0.0.0
WEB_PORT=3010
# Host-published Redis port (container stays 6379). The host-networked scanner
# reaches Redis here — keep in sync if you change it. Default avoids clashes
# with a local redis-server already on 6379.
REDIS_PORT=6378
# Leave empty: the UI calls the API same-origin through the Next.js proxy.
# Set only if the browser should hit the API directly (e.g. a remote URL).
NEXT_PUBLIC_API_URL=
CORS_ORIGINS=http://localhost:3010
# Optional: pin the interface the scanner uses (e.g. eth0). Empty = auto-detect default route iface.
SCAN_INTERFACE=
# --- Scanner ---
# Extra/explicit networks to scan, comma-separated CIDRs. When empty the
# scanner auto-detects the local subnet (unless SCAN_ONLY_CONFIGURED=true).
SCAN_NETWORKS=
# Never scan these networks (blocks manual scans too).
SCAN_EXCLUDE_NETWORKS=
# Only allow scans inside SCAN_NETWORKS.
SCAN_ONLY_CONFIGURED=false
# Recurring scan interval in minutes. 0 = manual scans only.
SCAN_INTERVAL_MINUTES=0
# Minimum seconds between manual scans of the same CIDR (rate limit).
SCAN_MIN_INTERVAL_SECONDS=15
# Refuse scan targets with more usable hosts than this (default 4096 ≈ /20) —
# protects the worker from oversized ranges. Also editable in Settings.
SCAN_MAX_HOSTS=4096
# TCP ports probed on each discovered host (used for service/device typing).
SCAN_TCP_PORTS=22,80,443,445,8080

# --- Auth ---
# On first launch the UI asks you to create a password. To provision one in
# advance (automation), set IPAMBOX_PASSWORD or point IPAMBOX_PASSWORD_FILE at
# a file containing it (the file wins and keeps the secret out of the env).
IPAMBOX_PASSWORD=
IPAMBOX_PASSWORD_FILE=
# Master key for secrets at rest — encrypts the credentials later features
# store (required for monitoring channels, SNMP credentials, controller
# sync, OIDC). IPAMBOX_SECRET_KEY_FILE wins over IPAMBOX_SECRET_KEY, keeping
# the key out of the env. ROTATING THIS KEY INVALIDATES every stored
# credential — they must be re-entered; there is no re-wrap tooling.
IPAMBOX_SECRET_KEY=
IPAMBOX_SECRET_KEY_FILE=
# How long a login lasts, in hours (default 168 = one week).
IPAMBOX_SESSION_HOURS=168
# Disable auth entirely — ONLY if a reverse proxy in front already handles it.
IPAMBOX_ALLOW_INSECURE=false
# false (default): logins work over plain HTTP on a LAN — browsers reject
# Secure cookies on non-localhost http origins. Set true when serving HTTPS.
# NOTE: over plain HTTP the session cookie crosses the LAN in cleartext —
# use HTTPS or restrict to a trusted network.
IPAMBOX_COOKIE_SECURE=false
# Comma-separated IPs/CIDRs whose X-Forwarded-For headers are trusted (used
# for login lockout keying). Default trusts loopback plus the web proxy's
# pinned bridge address — keep in sync with services.web.networks in
# docker-compose.yml.
IPAMBOX_TRUSTED_PROXIES=127.0.0.1,::1,192.0.2.10

# --- Backup ---
# Directory (inside the containers) where scheduled snapshots are written.
# Mounted as the backupdata volume — files are also downloadable from Settings.
BACKUP_DIR=/backups
# Recurring backup interval in minutes. 0 = manual downloads only.
BACKUP_INTERVAL_MINUTES=0
# How many scheduled backup files to keep on disk (oldest pruned first).
BACKUP_KEEP=14

# --- Racks ---
# Base URL of a self-hosted Rackula instance (e.g. http://rackula:8042) —
# enables "Open in Rackula" on rack pages. Leave empty in air-gapped setups.
# Also editable in Settings > Features.
IPAMBOX_RACKULA_BASE_URL=
